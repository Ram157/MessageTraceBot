{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-business-watcher",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "BOT_TOKEN",
      "WEBHOOK_SECRET",
      "SETUP_SECRET",
      "ENCRYPTION_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-business-watcher",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
